{
  "version": "0.2",
  "description": "OCR Deck Composer reconstruction presets, scope presets, and role-based placement rules",

  "mode_presets": {
    "debug": {
      "label": "Debug",
      "min_confidence": 0.0,
      "exclude_logo": false,
      "exclude_footer": false,
      "exclude_decoration": false,
      "mark_source": true
    },

    "draft": {
      "label": "Draft",
      "min_confidence": 0.2,
      "exclude_logo": false,
      "exclude_footer": false,
      "exclude_decoration": false,
      "mark_source": false
