    "working": {
      "label": "Working",
      "min_confidence": 0.35,
      "exclude_logo": true,
      "exclude_footer": true,
      "exclude_decoration": true,
      "mark_source": false
    },

    "clean": {
      "label": "Clean",
      "min_confidence": 0.55,
      "exclude_logo": true,
      "exclude_footer": true,
      "exclude_decoration": true,
      "mark_source": false
    },

